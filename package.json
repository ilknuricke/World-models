{
  "name": "suspension-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:ai": "vite --mode ai",
    "assets": "node scripts/build-assets.mjs",
    "build": "node scripts/build-assets.mjs && vite build",
    "preview": "vite preview",
    "preview:ai": "vite preview --mode ai",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint:deps": "depcruise src worker --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint:deps && npm test",
    "e2e": "npm run build && playwright test --trace off",
    "typegen": "wrangler types --strict-vars=false",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "smoke:live": "node --env-file-if-exists=.env.local scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "camera-controls": "3.1.2",
    "hono": "4.13.19",
    "mitt": "3.0.1",
    "n8ao": "2.1.0",
    "nanostores": "1.5.5",
    "partysocket": "1.3.0",
    "postprocessing": "6.39.6",
    "stats-gl": "4.2.3",
    "three": "0.187.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "dependency-cruiser": "18.8.0",
    "meshoptimizer": "1.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
