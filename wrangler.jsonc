{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Generic offline config. Keep deployment account/resource IDs in ignored wrangler.local.jsonc.
  "name": "suspension-lab",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-20",
  "upload_source_maps": true,
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*", "/r/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ],
  "d1_databases": [
    {
      "binding": "REPLAYS",
      "database_name": "suspension-lab-replays",
      "migrations_dir": "worker/migrations"
    }
  ],
  "ai": { "binding": "AI", "remote": true },
  // Anonymous usage statistics are optional. Leave Analytics Engine unbound until explicitly enabled on this account.
  "vars": { "APP_VERSION": "dev" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
